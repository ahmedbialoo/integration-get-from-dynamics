    public TpmPropertyId parmPropertyId(TpmPropertyId _PropertyId = PropertyId)
    {
        if (!prmIsDefault(_PropertyId))
        {
            PropertyId = _PropertyId;
        }
        return PropertyId;
    }

    [DataMember("FloorId")]
    public TpmPropertyFloorId parmFloorId(TpmPropertyFloorId _FloorId = FloorId)
    {
        if (!prmIsDefault(_FloorId))
        {
            FloorId = _FloorId;
        }
        return FloorId;
    }

