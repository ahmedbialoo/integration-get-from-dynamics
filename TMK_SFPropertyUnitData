    public TpmPropertyZoneId parmZoneId(TpmPropertyZoneId _ZoneId = ZoneId)
    {
        if (!prmIsDefault(_ZoneId))
        {
            ZoneId = _ZoneId;
        }
        return ZoneId;
    }

    [DataMember("PropertyUnitId")]
    public TpmPropertyUnitId parmPropertyUnitId(TpmPropertyUnitId _PropertyUnitId = PropertyUnitId)
    {
        if (!prmIsDefault(_PropertyUnitId))
        {
            PropertyUnitId = _PropertyUnitId;
        }
        return PropertyUnitId;
    }

    [DataMember("Description")]
    public Description parmDescription(Description _Description = Description)
    {
        if (!prmIsDefault(_Description))
        {
            Description = _Description;
        }
        return Description;
    }

}
